#!/usr/bin/env bash
set -euo pipefail

if [ $# -eq 0 ]; then
    echo "Usage: $0 <prepare|plan|train|predict|predict-tree|custom-train|custom-predict|custom-evaluate|all> [args...]"
    exit 1
fi

START_TS=$(date +%s)
echo "[run] Starting: $*"

poetry run python -m src.nn_UNet.pipeline "$@"

END_TS=$(date +%s)
ELAPSED=$((END_TS - START_TS))
echo "[run] Finished in ${ELAPSED}s"
